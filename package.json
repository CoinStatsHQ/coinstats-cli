{
  "name": "coinstats-cli",
  "version": "0.1.2",
  "description": "Command-line interface for the CoinStats Public API",
  "type": "module",
  "bin": {
    "coinstats": "./dist/src/index.js"
  },
  "homepage": "https://github.com/CoinStatsHQ/coinstats-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoinStatsHQ/coinstats-cli.git"
  },
  "bugs": {
    "url": "https://github.com/CoinStatsHQ/coinstats-cli/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:coverage": "node ./scripts/check-endpoint-coverage.mjs",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "generate:client": "openapi-ts -i ./openapi/coinstats-public-api.json -o ./src/generated -c @hey-api/client-fetch",
    "prebuild": "node ./scripts/clean-dist.mjs",
    "prepack": "npm run generate:client && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "coinstats",
    "crypto",
    "api",
    "cli",
    "ai-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^9.24.0",
    "@hey-api/openapi-ts": "^0.94.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.24.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.29.1",
    "vitest": "^4.0.18"
  }
}
